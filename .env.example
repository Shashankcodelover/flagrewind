# Flagsmith instance base API URL (self-hosted default)
FLAGSMITH_API_URL=http://localhost:8000/api/v1/

# Flagsmith Organisation API Key used by FlagRewind agent (keep separate from drill key)
FLAGREWIND_ADMIN_KEY=replace-with-agent-org-api-key

# Shared HMAC secret for environment webhook verification
FLAGREWIND_WEBHOOK_SECRET=replace-with-webhook-secret

# Demo service Flagsmith Server-Side Environment Key (starts with ser.)
FLAGSMITH_DEMO_SERVER_KEY=replace-with-demo-server-side-key

# Separate Organisation API Key used ONLY by scripts/bootstrap.py and drills/runner.py
FLAGREWIND_DRILL_KEY=replace-with-drill-org-api-key

# Optional non-flag fault switch for Scenario 7 in demo_service ("1" triggers synthetic fault)
FLAGREWIND_NON_FLAG_FAULT=0

# Optional LLM endpoint (Gemini OpenAI-compatible free tier or local Ollama)
# Gemini: https://generativelanguage.googleapis.com/v1beta/openai/
# Ollama: http://localhost:11434/v1/
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=replace-with-gemini-or-ollama-key
LLM_MODEL=gemini-2.5-flash

# Optional P1 Flagsmith MCP Server URL (when mcp_reader is enabled)
FLAGSMITH_MCP_URL=http://localhost:8003/mcp
